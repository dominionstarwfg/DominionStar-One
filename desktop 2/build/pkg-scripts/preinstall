#!/bin/sh
set -eu

APP="/Applications/DominionStar Meet.app"
LOG="/var/log/dominionstar-meet-installer.log"

log() {
  /bin/echo "$(/bin/date '+%Y-%m-%d %H:%M:%S') [preinstall] $*" >> "$LOG"
}

log "Starting DominionStar Meet replacement install."

/usr/bin/pkill -x "DominionStar Meet" >/dev/null 2>&1 || true
/bin/sleep 2

if /usr/bin/pgrep -x "DominionStar Meet" >/dev/null 2>&1; then
  log "DominionStar Meet did not exit normally; forcing termination."
  /usr/bin/pkill -9 -x "DominionStar Meet" >/dev/null 2>&1 || true
  /bin/sleep 1
fi

if [ -d "$APP" ]; then
  OLD_VERSION=$(/usr/libexec/PlistBuddy -c "Print :CFBundleShortVersionString" "$APP/Contents/Info.plist" 2>/dev/null || /bin/echo "unknown")
  log "Preparing existing app version ${OLD_VERSION} at ${APP} for atomic package upgrade."
else
  log "No existing DominionStar Meet app found; performing clean install."
fi

# Do not delete the app bundle here. macOS Installer resolves component destinations
# before package scripts run. Deleting the destination from preinstall can invalidate
# the install transaction. The package component is configured as non-relocatable with
# BundleOverwriteAction=upgrade so Installer atomically replaces the old bundle itself.
exit 0
