{
  "name": "dominionstar-desktop",
  "version": "1.0.9",
  "description": "DominionStar Meet desktop application for Windows and macOS",
  "author": "DominionStar Leadership and Development",
  "main": "src/main.mjs",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "electron .",
    "verify": "node scripts/verify.mjs && node scripts/test-capture-source.mjs && node scripts/test-capture-session.mjs",
    "pack": "electron-builder --dir",
    "dist:windows": "electron-builder --win nsis --x64 --arm64",
    "dist:mac": "electron-builder --mac dmg zip --universal"
  },
  "devDependencies": {
    "electron": "43.3.0",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6"
  },
  "build": {
    "appId": "com.dominionstar.desktop",
    "productName": "DominionStar Meet",
    "asar": true,
    "asarUnpack": [
      "node_modules/@nut-tree-fork/libnut-*/**/*"
    ],
    "files": [
      "src/**/*",
      "package.json"
    ],
    "protocols": [
      {
        "name": "DominionStar Meeting Link",
        "schemes": [
          "dominionstar"
        ]
      }
    ],
    "artifactName": "DominionStar-Meet-${version}-${os}-${arch}.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "mac": {
      "category": "public.app-category.business",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "universal"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "src/entitlements.mac.plist",
      "entitlementsInherit": "src/entitlements.mac.plist",
      "extendInfo": {
        "NSCameraUsageDescription": "DominionStar uses your camera when you choose to join a meeting with video.",
        "NSMicrophoneUsageDescription": "DominionStar uses your microphone when you choose to speak in a meeting.",
        "NSAudioCaptureUsageDescription": "DominionStar Meet uses system audio only when you explicitly choose to include computer sound in a screen share.",
        "NSScreenCaptureDescription": "DominionStar uses screen capture only when you choose to share your screen."
      }
    }
  }
}
